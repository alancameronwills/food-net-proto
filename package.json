{
  "name": "bwyd-lleol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bwyd Lleol Sir Benfro - local food network prototype",
  "scripts": {
    "db:up": "docker compose up -d dynamodb",
    "db:down": "docker compose down",
    "seed": "tsx src/server/cli.ts seed",
    "reset": "tsx src/server/cli.ts reset",
    "dev:api": "tsx watch src/server/local.ts",
    "dev:web": "vite",
    "dev": "concurrently -n api,web -c blue,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "i18next": "^23.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
